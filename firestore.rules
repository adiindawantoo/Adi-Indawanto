rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Global safety net: deny all access by default
    match /{document=**} {
      allow read, write: if false;
    }

    // Common security helpers
    function isSignedIn() {
      return request.auth != null;
    }

    function isMainAdmin() {
      return isSignedIn() && request.auth.token.email.lower() == 'adi.indawanto@gmail.com';
    }

    function isAdmin() {
      return isSignedIn() && (
        isMainAdmin() ||
        (
          exists(/databases/$(database)/documents/allowed_email/$(request.auth.token.email.lower())) &&
          (
            get(/databases/$(database)/documents/allowed_email/$(request.auth.token.email.lower())).data.role == 'admin' ||
            !('role' in get(/databases/$(database)/documents/allowed_email/$(request.auth.token.email.lower())).data)
          )
        )
      );
    }

    // Explicit rules for app collections
    match /allowed_email/{docId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /task/{docId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /fixed_asset/{docId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /animal/{docId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /cctv/{docId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /mep/{docId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /museum_collection/{docId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /fixed_asset_transfers/{docId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /stock_opname_sessions/{docId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /asset_location/{docId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /asset_category/{docId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /asset_maintenance/{docId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
  }
}
